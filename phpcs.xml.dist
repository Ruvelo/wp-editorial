<?xml version="1.0"?>
<ruleset name="Ruvelo Editorial">
    <description>WordPress security, database, i18n and PHP sniffs. Code style is Pint's job (PSR-12, Laravel preset).</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/.wp/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/bin/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="7.0"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ruvelo-editorial"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.WP.DiscouragedFunctions"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.PHP">
        <exclude name="WordPress.PHP.POSIXFunctions"/>
        <!-- Yoda conditions are a style choice; Pint's PSR-12 style doesn't use them. -->
        <exclude name="WordPress.PHP.YodaConditions"/>
        <!-- strict_types and typed signatures make loose comparisons rare; in_array() calls pass true explicitly. -->
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="ruvelo"/>
                <element value="Ruvelo\WP\Editorial"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidHookName"/>
</ruleset>
